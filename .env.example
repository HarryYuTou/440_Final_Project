# Main runs without copying this file or supplying any credentials.
# Enable ONLY to inspect synthetic contract examples in local development.
# The fixture route is always disabled in production, even when this is true.
ENABLE_DEV_FIXTURES=false

# Future service configuration. These are reserved names, not live adapters.
# Catalog/integration owner selects the database and hosting provider.
DATABASE_URL=
APP_URL=http://localhost:3000

# Catalog/integration owner also selects the identity provider and configures Stripe.
AUTH_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# AI recommendations owner selects the model provider; the AI trip map reuses the same server-side key.
MODEL_API_KEY=
MODEL_NAME=

# AI trip map: set to true only once the team makes the trip map the paid benefit.
# Then /api/trip requires an allowed server-side access check (AccountsService.getAccess).
TRIP_REQUIRES_ACCESS=false

# Never prefix secret values with NEXT_PUBLIC_. Keep actual values out of Git.
